PORT=8080
# MongoDB Atlas (o endereço do cluster e o nome do banco ficam no src/db/db.js)
MONGODB_USERNAME=
MONGODB_PASSWORD=
JWT_SECRET=troque-por-um-texto-longo-e-aleatorio

# Chave para criptografar a senha de app do Gmail guardada no banco: 32 bytes em hex.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_CRYPTO_KEY=
# Limite diário de envio por e-mail de Gmail via SMTP (o próprio limite da Google). Sem isso, usa 500.
GMAIL_LIMITE_DIARIO=500

# Google Places API (New): chave do sistema, usada por todas as contas
GOOGLE_API_KEY=
# Quantas páginas de busca no Google (até 20 resultados cada) cada conta pode usar por mês, se o super admin não definir outra
GOOGLE_COTA_MENSAL=100

# Opcional: token de aplicativo dos portais de dados abertos (Socrata). Sem ele funciona, com limite menor de requisições
SOCRATA_APP_TOKEN=
